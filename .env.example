# Supabase Configuration
# Obtain these values from your Supabase project settings (Project Settings -> API / Database)

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (secret key with administrative privileges for backend operations)
# CAUTION: Never expose this key in client-side code or commit real keys to version control.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Database URL (Connection Pooling or Direct)
# Used for direct database migrations and psql / connection pooling
# Example: postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Tool Gateway Security
# Secret used by backend/AI services to authenticate requests via X-Tool-Secret header
TOOL_GATEWAY_SECRET=your-secure-tool-gateway-secret

# Confirmation token signing
# Use a separate, randomly generated secret in production.
CONFIRMATION_SECRET=your-secure-confirmation-secret

# Retell transport (backend only)
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=your-retell-agent-id
RETELL_WEBHOOK_SECRET=your-retell-webhook-signing-key

# Brand identity
BRAND_NAME=NexGen
AGENT_NAME=NexGen Assistant
ENVIRONMENT=production

# Transactional email (backend only)
# For Gmail, use the full Gmail address and a Google App Password. Do not use
# your normal Google account password. Never expose these variables to Vite or
# prefix them with VITE_.
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=NexGen AI Fashion & Voice Commerce
EMAIL_FROM_ADDRESS=orders@your-domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_USE_TLS=true
PAYMENT_PLACEHOLDER_URL=https://example.com/complete-payment

# Internal operations access. Generate ADMIN_PASSWORD_HASH with SHA-256; never store the password here.
ADMIN_EMAIL=operations@example.com
ADMIN_PASSWORD_HASH=replace-with-sha256-password-hash

